# Copy these keys into Vercel Project Settings > Environment Variables.
# Do not commit real secrets.

# Postgres connection string used by Prisma (prisma/schema.prisma, prisma.config.ts)
DATABASE_URL=

# App URLs
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_ACCOUNTANT_API_URL=
PHP_URL=

# Database
MONGODB_URI=
MONGODB_DB_NAME=omsons
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=
MONGODB_TLS_ALLOW_INVALID_HOSTNAMES=

# Supabase server-side access (global search only; PDF/invoice storage moved to Cloudinary)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (slider images, ledger bill PDFs, invoices, order exports)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth
JWT_SECRET=
AUTH_REFRESH_PEPPER=
AUTH_OTP_PEPPER=
ENABLE_EMAIL_OTP=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
AUTH_JWT_ISSUER=omsons
AUTH_JWT_AUDIENCE=omsons-web

# AI search
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ordering agent LLM (OpenAI-compatible endpoint). Server-only: never NEXT_PUBLIC_.
# Testing (Groq):     AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
# Production (Gemini): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_RATE_LIMIT_PER_MIN=15

# Optional tuning
LEDGER_FETCH_TIMEOUT_MS=30000
