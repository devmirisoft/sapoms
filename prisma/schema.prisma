// Generated order invoices. The PDF itself lives in Cloudinary as an
// extension-less raw blob (the account blocks PDF-format delivery), so
// cloudinaryUrl is never handed to the browser directly — the download route
// streams it with the right content type. Rows created before the Cloudinary
// cutover carry their original Supabase URL and no publicId.
model Invoice {
  id BigInt @id @default(autoincrement())

  dealerId BigInt  @map("dealer_id")
  orderId  BigInt? @map("order_id")

  invoiceNumber String @map("invoice_number")
  orderNumber   String @map("order_number")
  buyerName     String @map("buyer_name")

  totalAmountPaise BigInt   @default(0) @map("total_amount_paise")
  invoiceDate      DateTime @map("invoice_date") @db.Date

  cloudinaryUrl      String  @map("cloudinary_url") @db.Text
  cloudinaryPublicId String? @map("cloudinary_public_id")
  fileName           String  @map("file_name")
  fileBytes          Int?    @map("file_bytes")

  createdByUserId BigInt?   @map("created_by_user_id")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  dealer    DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Stops the same order being billed twice — the check the orders page
  // previously did by listing every invoice and comparing in the browser.
  @@unique([dealerId, invoiceNumber])
  @@index([dealerId, createdAt])
  @@index([orderId])
  @@map("invoices")
}

// Multi-order PDF exports (order history reports), stored the same way.
model OrderExport {
