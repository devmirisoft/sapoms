// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: npx create-db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  ADMIN
  NSM
  ACCOUNTANT
  RSM
  ASM
  STAFF
  DEALER
}

model AuthAuditLog {
  id            BigInt    @id @default(autoincrement())
  sessionId     String?   @map("session_id")
  legacyActorId String?   @map("legacy_actor_id")
  role          AuthRole?
  eventType     String    @map("event_type")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([legacyActorId, createdAt])
  @@map("auth_audit_logs")
}

enum UserRole {
  ADMIN
  NSM
  ACCOUNTANT
  RSM
  ASM
  STAFF
  DEALER
}

enum SalesRegion {
  NORTH_1
  NORTH_2
  SOUTH_1
  SOUTH_2
  WEST_1
  WEST_2
  EAST
  ROM
  CENTRAL
}

// Dispatch warehouses. A Staff member is pinned to one, and order visibility
// follows the warehouse of the order's assigned staff.
enum Warehouse {
  AHMEDABAD
  AMBALA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 BigInt     @id @default(autoincrement())
  email              String
  normalizedEmail    String     @unique @map("normalized_email")
  username           String?
  normalizedUsername String?    @unique @map("normalized_username")
  passwordHash       String     @map("password_hash")
  role               UserRole
  status             UserStatus @default(ACTIVE)
  tokenVersion       Int        @default(1) @map("token_version")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  sessions                 AuthSession[]
  emailOtps                EmailOtp[]
  createdDiagnosticPasswords DiagnosticPassword[] @relation("DiagnosticPasswordCreatedBy")
  revokedDiagnosticPasswords DiagnosticPassword[] @relation("DiagnosticPasswordRevokedBy")
  adminProfile             AdminProfile?
  accountantProfile        AccountantProfile?
  staffProfile             StaffProfile?
  dealerProfile            DealerProfile?
  regionalDealers          DealerProfile[]         @relation("DealerRegionalManager")
  createdOrders            Order[]                 @relation("OrderCreatedBy")
  orderNotes               OrderNote[]             @relation("OrderNoteActor")
  orderProductNotes        OrderProductNote[]      @relation("OrderProductNoteActor")
  orderSummaryOverrides    OrderSummaryOverride[]  @relation("OrderSummaryOverrideActor")
  orderOverlays            OrderOverlay[]          @relation("OrderOverlayActor")
  createdSliderImages      SliderImage[]           @relation("SliderImageCreatedBy")
  createdHotItems          HotItem[]               @relation("HotItemCreatedBy")
  createdDealers           DealerProfile[]         @relation("DealerCreatedBy")
  createdDealerAssignments DealerStaffAssignment[] @relation("DealerAssignmentCreatedBy")
  reviewedCustomDiscounts  CustomDiscountRequest[] @relation("CustomDiscountReviewedBy")
  formSubmissions          FormSubmission[]        @relation("FormSubmissionSubmittedBy")
  openedWalletSettlements  WalletSettlement[]      @relation("WalletSettlementOpenedBy")
  appliedWalletSettlements WalletSettlementApplication[] @relation("WalletSettlementAppliedBy")
  createdInvoices          Invoice[]               @relation("InvoiceCreatedBy")
  createdOrderExports      OrderExport[]           @relation("OrderExportCreatedBy")
  regionalFundRequests     DealerFundRequest[]     @relation("FundRequestRsm")
  rsmReviewedFundRequests  DealerFundRequest[]     @relation("FundRequestRsmReviewer")
  staffReviewedFundRequests DealerFundRequest[]    @relation("FundRequestStaffReviewer")
  fundedFundRequests       DealerFundRequest[]     @relation("FundRequestAccountant")

  @@index([role, status])
  @@map("users")
}

model ProductCategory {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String?  @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([name])
  @@map("product_categories")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  productCode String?  @unique @map("product_code")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  categoryId  BigInt?  @map("category_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]
  hotItems   HotItem[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id              BigInt   @id @default(autoincrement())
  productId       BigInt   @map("product_id")
  sku             String?  @unique
  catalogueNumber String?  @map("catalogue_number")
  unitName        String?  @map("unit_name")
  packSize        Int?     @map("pack_size")
  unitPricePaise  BigInt   @default(0) @map("unit_price_paise")
  packPricePaise  BigInt   @default(0) @map("pack_price_paise")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  hotItems   HotItem[]

  @@index([productId])
  @@index([catalogueNumber])
  @@map("product_variants")
}

model HotItem {
  id              BigInt   @id @default(autoincrement())
  productId       BigInt   @map("product_id")
  variantId       BigInt?  @map("variant_id")
  position        Int
  isActive        Boolean  @default(true) @map("is_active")
  badge           String   @default("Hot pick")
  skuSnapshot     String   @map("sku_snapshot")
  nameSnapshot    String   @map("name_snapshot")
  specsSnapshot   String   @default("") @map("specs_snapshot") @db.Text
  imageSnapshot   String   @default("") @map("image_snapshot") @db.Text
  createdByUserId BigInt   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy User            @relation("HotItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([productId, variantId])
  @@index([position])
  @@index([isActive, position])
  @@map("hot_items")
}

model SliderImage {
  id                 BigInt   @id @default(autoincrement())
  title              String?
  imageUrl           String   @map("image_url") @db.Text
  cloudinaryPublicId String   @unique @map("cloudinary_public_id")
  position           Int      @default(0)
  isActive           Boolean  @default(true) @map("is_active")
  createdByUserId    BigInt?  @map("created_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User? @relation("SliderImageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, position])
  @@index([position])
  @@map("slider_images")
}
model AuthSession {
  id               String    @id @default(uuid())
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AdminProfile {
  id          BigInt  @id @default(autoincrement())
  userId      BigInt  @unique @map("user_id")
  displayName String  @map("display_name")
  phone       String?
  imageUrl    String? @map("image_url")

  user           User           @relation(fields: [userId], references: [id])
  managedRsms    StaffProfile[] @relation("StaffReportingManager")

  @@map("admin_profiles")
}

model AccountantProfile {
  id          BigInt  @id @default(autoincrement())
  userId      BigInt  @unique @map("user_id")
  displayName String  @map("display_name")
  designation String?

  user User @relation(fields: [userId], references: [id])

  @@map("accountant_profiles")
}

model StaffProfile {
  id             BigInt  @id @default(autoincrement())
  userId         BigInt  @unique @map("user_id")
  parentRsmId    BigInt? @map("parent_rsm_id")
  parentAsmId    BigInt? @map("parent_asm_id")
  displayName    String  @map("display_name")
  designation    String?
  location       String?
  mobileNo       String?   @map("mobile_no")
  alternateNo    String?   @map("alternate_no")
  permanentAddress String? @map("permanent_address") @db.Text
  localAddress   String?   @map("local_address") @db.Text
  gender         String?
  dob            DateTime? @db.Date
  nationality    String?
  maritalStatus  String?   @map("marital_status")
  qualification  String?
  emergencyContactNo1 String? @map("emergency_contact_no_1")
  emergencyContactNo2 String? @map("emergency_contact_no_2")
  staffRoleType  String? @map("staff_role_type")
  salesRegion    SalesRegion? @map("sales_region")
  warehouse      Warehouse?
  assignedStates String[] @default([]) @map("assigned_states")
  assignedCities String[] @default([]) @map("assigned_cities")
  reportingManagerId BigInt? @map("reporting_manager_id")

  user                   User                    @relation(fields: [userId], references: [id])
  parentRsm              StaffProfile?           @relation("StaffParentRsm", fields: [parentRsmId], references: [id], onDelete: SetNull)
  parentAsm              StaffProfile?           @relation("StaffParentAsm", fields: [parentAsmId], references: [id], onDelete: SetNull)
  reportingManager        AdminProfile?          @relation("StaffReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  asmChildren            StaffProfile[]          @relation("StaffParentRsm")
  executiveChildren      StaffProfile[]          @relation("StaffParentAsm")
  assignedOrders         Order[]
  customDiscountRequests CustomDiscountRequest[]
  dealerAssignments      DealerStaffAssignment[]
  fundRequests           DealerFundRequest[]
  diagnosticPasswords    DiagnosticPassword[]

  @@index([parentRsmId])
  @@index([parentAsmId])
  @@index([reportingManagerId])
  @@index([warehouse])
  @@map("staff_profiles")
}

model DealerProfile {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @unique @map("user_id")
  legacyPhpId      String?   @unique @map("legacy_php_id")
  dealerCode       String?   @unique @map("dealer_code")
  businessName     String    @map("business_name")
  phone            String?
  city             String?
  address          String?
  state            String?
  pincode          String?
  gstin            String?
  discountPercent  Decimal?  @map("discount_percent") @db.Decimal(9, 4)
  creditDays       Int?      @map("credit_days")
  creditLimitPaise BigInt?   @map("credit_limit_paise")
  annualTargetPaise BigInt?  @map("annual_target_paise")
  notes            String?
  priorityContact  String    @default("primary") @map("priority_contact")
  secondaryContactName  String? @map("secondary_contact_name")
  secondaryContactPhone String? @map("secondary_contact_phone")
  secondaryContactEmail String? @map("secondary_contact_email")
  additionalContacts    Json?   @map("additional_contacts")
  termsAcceptedAt  DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  imageUrl         String?   @map("image_url")
  region           SalesRegion?
  rsmUserId        BigInt?   @map("rsm_user_id")
  createdByUserId  BigInt?   @map("created_by_user_id")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User                    @relation(fields: [userId], references: [id])
  regionalManager        User?                   @relation("DealerRegionalManager", fields: [rsmUserId], references: [id], onDelete: SetNull)
  createdBy              User?                   @relation("DealerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  orders                 Order[]
  ledgerBills            LedgerBill[]
  wallet                 DealerWallet?
  walletTransactions     WalletTransaction[]
  orderDrafts            OrderDraft[]
  draftCart              DraftCart?
  customDiscountRequests CustomDiscountRequest[]
  diagnosticPasswords    DiagnosticPassword[]
  staffAssignments       DealerStaffAssignment[]
  walletSettlements      WalletSettlement[]
  invoices               Invoice[]
  orderExports           OrderExport[]
  fundRequests           DealerFundRequest[]

  @@index([deletedAt])
  @@index([region])
  @@index([rsmUserId])
  @@map("dealer_profiles")
}

// One temporary-login table for both dealer and staff profiles: exactly one of
// dealer_id / staff_id is set (enforced by a CHECK constraint in the migration).
model DiagnosticPassword {
  id              BigInt    @id @default(autoincrement())
  dealerId        BigInt?   @map("dealer_id")
  staffId         BigInt?   @map("staff_id")
  passwordHash    String    @map("password_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdByUserId BigInt    @map("created_by_user_id")
  revokedByUserId BigInt?   @map("revoked_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  dealer    DealerProfile? @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  staff     StaffProfile?  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy User           @relation("DiagnosticPasswordCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy User?          @relation("DiagnosticPasswordRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([dealerId, expiresAt])
  @@index([staffId, expiresAt])
  @@index([revokedAt])
  @@map("diagnostic_passwords")
}

model DealerStaffAssignment {
  id BigInt @id @default(autoincrement())

  dealerId BigInt @map("dealer_id")
  staffId  BigInt @map("staff_id")

  assignedByUserId BigInt? @map("assigned_by_user_id")

  active Boolean @default(true)

  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dealer DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  staff  StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  assignedBy User? @relation("DealerAssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([dealerId, staffId])
  @@index([dealerId, active])
  @@index([staffId, active])
  @@map("dealer_staff_assignments")
}

enum OrderStatus {
  DRAFT
  AWAITING_ACCEPTANCE
  ACCEPTED
  DECLINED
  PROCESSING
  PARTIALLY_READY
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum OrderAcceptanceStatus {
  AWAITING
  ACCEPTED
  DECLINED
}

enum OrderFulfilmentStatus {
  PENDING
  IN_PROCESS
  PARTIALLY_READY
  READY
  DISPATCHED
  COMPLETED
}

enum OrderDiscountType {
  NONE
  SLAB
  CUSTOM
}

enum DiscountRequestScope {
  ORDER
  PRODUCT
}

enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WalletStatus {
  ACTIVE
  INACTIVE
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  ORDER_DEBIT
  REFUND
  ADJUSTMENT
}

enum WalletSettlementStatus {
  OPEN
  SETTLED
  VOID
}

enum OrderDraftStatus {
  ACTIVE
  CONVERTED
  CANCELLED
}

enum FundRequestType {
  ADVANCE_ORDER
  ADDITIONAL_FUNDS
}

/* One column drives the whole workflow. The intermediate *_PENDING states are
   implied by the previous stage's approval, so they are not separate values:
   RSM_PENDING is the initial REQUESTED, STAFF_PENDING is RSM_APPROVED, and
   ACCOUNTANT_PENDING is STAFF_APPROVED. Keeping it to the states that are
   actually written makes an invalid transition a single equality check. */
enum FundRequestStatus {
  REQUESTED
  RSM_APPROVED
  STAFF_APPROVED
  FUNDED
  COMPLETED
  REJECTED
}

model DealerRequest {
  id                   BigInt    @id @default(autoincrement())
  requestReference     String?   @unique @map("request_reference")
  requestIdentityKey   String    @map("request_identity_key")
  openRequestKey       String?   @unique @map("open_request_key")
  status               String    @default("pending")
  dealerName           String    @map("dealer_name")
  dealerCode           String    @map("dealer_code")
  city                 String
  contactEmail         String    @map("contact_email")
  contactPhone         String    @map("contact_phone")
  assignedStaffIds     String[]  @default([]) @map("assigned_staff_ids")
  assignedStaffNames   String    @map("assigned_staff_names")
  region               SalesRegion?
  rsmUserId            BigInt?   @map("rsm_user_id")
  submittedById        String    @map("submitted_by_id")
  submittedByName      String    @map("submitted_by_name")
  reviewedById         String    @default("") @map("reviewed_by_id")
  reviewedByName       String    @default("") @map("reviewed_by_name")
  createdDealerId      String    @default("") @map("created_dealer_id")
  rejectionReason      String    @default("") @map("rejection_reason")
  lastRejectionReason  String    @default("") @map("last_rejection_reason")
  formSnapshot         Json      @map("form_snapshot")
  approvalLock         Json?     @map("approval_lock")
  auditTrail           Json      @default("[]") @map("audit_trail")
  creationAttemptCount Int       @default(0) @map("creation_attempt_count")
  submittedAt          DateTime  @map("submitted_at") @db.Timestamptz(6)
  acceptedAt           DateTime? @map("accepted_at") @db.Timestamptz(6)
  rejectedAt           DateTime? @map("rejected_at") @db.Timestamptz(6)
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(6)
  resubmittedAt        DateTime? @map("resubmitted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, updatedAt])
  @@index([submittedById, status, updatedAt])
  @@index([region, status, updatedAt])
  @@index([rsmUserId, status, updatedAt])
  @@index([dealerName])
  @@index([dealerCode])
  @@map("dealer_requests")
}

model Order {
  id BigInt @id @default(autoincrement())

  legacyPhpId String? @unique @map("legacy_php_id")
  orderNumber String  @unique @map("order_number")

  dealerId        BigInt  @map("dealer_id")
  assignedStaffId BigInt? @map("assigned_staff_id")
  createdByUserId BigInt? @map("created_by_user_id")

  // Prevent duplicate order submission
  idempotencyKey String? @unique @map("idempotency_key")

  orderDate DateTime @default(now()) @map("order_date") @db.Timestamptz(6)

  shipTo String? @map("ship_to")
  refNo  String? @map("ref_no")
  note   String? @db.Text

