  fileBytes          Int?    @map("file_bytes")
  orderCount         Int     @default(0) @map("order_count")

  createdByUserId BigInt?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dealer    DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("OrderExportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([dealerId, createdAt])
  @@map("order_exports")
}
/**
 * Dealer fund request: the advance dealer's route to money they do not have yet.
 *
 * Two shapes, one workflow (dealer -> RSM -> Staff -> Accountant -> wallet):
 *   ADVANCE_ORDER    the dealer tried to place an order the wallet cannot cover.
 *                    `orderFormSnapshot` holds the exact submission, replayed
 *                    through the normal order route once the funds land.
 *   ADDITIONAL_FUNDS a standalone top-up raised from the ledger. No order.
 *
 * The order is NOT created up front: only `orderId`, set at placement time,
 * says an order exists, which is also what makes double-placement impossible.
 */
model DealerFundRequest {
  id BigInt @id @default(autoincrement())

  dealerId BigInt @map("dealer_id")

  type   FundRequestType
  status FundRequestStatus @default(REQUESTED)

  // What the dealer needs added to the wallet.
  amountPaise BigInt @map("amount_paise")

  // Captured when the request was raised, for reviewers to see the shortfall
  // as the dealer saw it.
  walletBalancePaise BigInt  @default(0) @map("wallet_balance_paise")
  orderAmountPaise   BigInt? @map("order_amount_paise")

  // The dealer's own POST /api/dealer-order body, replayed verbatim on funding
  // so nothing can drift between what was approved and what is placed.
  orderFormSnapshot Json? @map("order_form_snapshot")

  // Set only once the order is actually created. Doubles as the
  // already-placed guard.
  orderId BigInt? @unique @map("order_id")

  dealerNote String? @map("dealer_note") @db.Text

  // Routing: resolved at creation from the dealer's region/assignment so the
  // queues stay stable even if the hierarchy is edited later.
  rsmUserId BigInt? @map("rsm_user_id")
  staffId   BigInt? @map("staff_id")

  rsmReviewedByUserId BigInt?   @map("rsm_reviewed_by_user_id")
  rsmReviewedByName   String?   @map("rsm_reviewed_by_name")
  rsmReviewedAt       DateTime? @map("rsm_reviewed_at") @db.Timestamptz(6)
  rsmNote             String?   @map("rsm_note") @db.Text

  staffReviewedByUserId BigInt?   @map("staff_reviewed_by_user_id")
  staffReviewedByName   String?   @map("staff_reviewed_by_name")
  staffReviewedAt       DateTime? @map("staff_reviewed_at") @db.Timestamptz(6)
  staffNote             String?   @map("staff_note") @db.Text

  accountantUserId BigInt?   @map("accountant_user_id")
  accountantName   String?   @map("accountant_name")
  fundedAt         DateTime? @map("funded_at") @db.Timestamptz(6)
  accountantNote   String?   @map("accountant_note") @db.Text

  // The CREDIT written by the accountant, so the record view can link straight
  // into the existing ledger instead of storing the amount twice.
  walletTransactionId BigInt? @unique @map("wallet_transaction_id")

  rejectedAt   DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy   String?   @map("rejected_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dealer            DealerProfile      @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  staff             StaffProfile?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  regionalManager   User?              @relation("FundRequestRsm", fields: [rsmUserId], references: [id], onDelete: SetNull)
  rsmReviewedBy     User?              @relation("FundRequestRsmReviewer", fields: [rsmReviewedByUserId], references: [id], onDelete: SetNull)
  staffReviewedBy   User?              @relation("FundRequestStaffReviewer", fields: [staffReviewedByUserId], references: [id], onDelete: SetNull)
  accountant        User?              @relation("FundRequestAccountant", fields: [accountantUserId], references: [id], onDelete: SetNull)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([dealerId, status])
  @@index([status, createdAt])
  @@index([rsmUserId, status])
  @@index([staffId, status])
  @@map("dealer_fund_requests")
}
